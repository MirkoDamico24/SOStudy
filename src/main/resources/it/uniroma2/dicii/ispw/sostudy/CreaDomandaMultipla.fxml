<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.dicii.ispw.sostudy.view.CreaDomandaMultiplaController">

    <!-- ==================== HEADER / NAV BAR ==================== -->
    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="50.0" style="-fx-border-color: #8CB8F5; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 15 60 15 40; -fx-background-color: #FAFAFA; -fx-background-radius: 12;">
                <children>
                    <Label text="SoStudy" textFill="#4D4CFF">
                        <font><Font name="System Bold Italic" size="36.0" /></font>
                        <HBox.margin><Insets right="30.0" /></HBox.margin>
                    </Label>
                    <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Home">
                        <font><Font name="Serif Regular" size="26.0" /></font>
                    </Button>
                    <Button fx:id="btnCreaTest" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #1C77FF transparent; -fx-border-width: 0 0 3 0; -fx-cursor: hand;" text="Crea test">
                        <font><Font name="Serif Regular" size="26.0" /></font>
                        <padding><Insets bottom="5.0" left="10.0" right="10.0" top="5.0" /></padding>
                    </Button>
                    <Button fx:id="btnClassiVirtuali" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Classi Virtuali">
                        <font><Font name="Serif Regular" size="26.0" /></font>
                    </Button>
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- ==================== PROFILO UTENTE (Top-Right) ==================== -->
    <HBox alignment="CENTER" spacing="20.0" AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="50.0">
        <children>
            <ImageView fx:id="profAvatar" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="profNameLabel" style="-fx-border-color: #8CB8F5; -fx-border-width: 1; -fx-padding: 8 20 8 20; -fx-background-color: white; -fx-text-fill: #555555;" text="Caricamento...">
                <font><Font name="System Regular" size="16.0" /></font>
            </Label>
        </children>
    </HBox>

    <!-- ==================== CONTENUTO CENTRALE (Adattabile) ==================== -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="180.0">
        <content>
            <VBox alignment="TOP_CENTER">
                <padding>
                    <Insets bottom="50.0" top="20.0" />
                </padding>
                <children>

                    <!-- Titolo Pagina -->
                    <Label style="-fx-text-fill: #000000;" text="Domanda a risposta multipla">
                        <font>
                            <Font name="Serif Bold" size="48.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="40.0" />
                        </VBox.margin>
                    </Label>

                    <!-- Card del Form -->
                    <VBox maxWidth="1050.0" style="-fx-background-color: #F5FCFF; -fx-border-color: #1C77FF; -fx-border-width: 1.5; -fx-border-radius: 2; -fx-background-radius: 2;">
                        <padding>
                            <Insets bottom="40.0" left="50.0" right="50.0" top="20.0" />
                        </padding>
                        <children>

                            <!-- Intestazione Form -->
                            <Label style="-fx-text-fill: #555555;" text="Domanda a risposta multipla">
                                <font><Font name="System Regular" size="18.0" /></font>
                                <VBox.margin><Insets bottom="5.0" /></VBox.margin>
                            </Label>
                            <Separator prefWidth="200.0">
                                <VBox.margin><Insets bottom="40.0" /></VBox.margin>
                            </Separator>

                            <!-- Griglia dei Campi -->
                            <GridPane hgap="40.0" vgap="40.0">
                                <columnConstraints>
                                    <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="350.0" minWidth="200.0" prefWidth="250.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" maxWidth="700.0" minWidth="400.0" prefWidth="550.0" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints minHeight="80.0" prefHeight="100.0" valignment="TOP" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="150.0" valignment="TOP" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="45.0" prefHeight="45.0" valignment="CENTER" vgrow="SOMETIMES" />
                                </rowConstraints>
                                <children>

                                    <!-- 1. Testo della domanda -->
                                    <Label style="-fx-text-fill: #555555;" text="Testo della domanda" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.valignment="TOP">
                                        <font><Font name="Serif Regular" size="30.0" /></font>
                                        <GridPane.margin><Insets top="10.0" /></GridPane.margin>
                                    </Label>
                                    <TextArea fx:id="testoDomandaArea" prefHeight="100.0" promptText="Inserire il testo della domanda" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <font><Font size="16.0" /></font>
                                    </TextArea>

                                    <!-- 2. Sezione Opzioni Dinamiche -->
                                    <Label style="-fx-text-fill: #555555;" text="Opzioni" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.valignment="CENTER">
                                        <font><Font name="Serif Regular" size="30.0" /></font>
                                    </Label>

                                    <!-- Contenitore delle opzioni -->
                                    <VBox spacing="15.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <children>

                                            <!-- LABEL "Soluzione" ALLINEATA SUI RADIO BUTTON TRAMITE TRANSLATEX -->
                                            <Label style="-fx-text-fill: #777777;" text="Soluzione" translateX="-20.0">
                                                <font><Font name="System Regular" size="14.0" /></font>
                                                <!-- Rimosso il margin left per evitare ulteriori sfalsamenti -->
                                            </Label>

                                            <!-- Questo VBox conterrà dinamicamente le righe (Radio + TextField + Cestino) -->
                                            <VBox fx:id="optionsListVBox" spacing="15.0" />

                                            <!-- Bottone Aggiungi Opzione -->
                                            <HBox alignment="CENTER">
                                                <VBox.margin><Insets top="10.0" /></VBox.margin>
                                                <children>
                                                    <Button mnemonicParsing="false" onAction="#handleAggiungiOpzione" style="-fx-background-color: #1C77FF; -fx-text-fill: white; -fx-background-radius: 50em; -fx-cursor: hand;" text="Aggiungi opzione">
                                                        <font><Font name="System Regular" size="16.0" /></font>
                                                        <padding><Insets bottom="6.0" left="20.0" right="20.0" top="6.0" /></padding>
                                                    </Button>
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <!-- 3. Punteggio -->
                                    <Label style="-fx-text-fill: #555555;" text="Punteggio" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <font><Font name="Serif Regular" size="30.0" /></font>
                                    </Label>
                                    <ComboBox fx:id="punteggioComboBox" prefHeight="45.0" prefWidth="550.0" promptText="Selezionare il punteggio massimo" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                </children>
                            </GridPane>

                            <!-- Bottone Salva -->
                            <HBox alignment="CENTER">
                                <VBox.margin><Insets top="60.0" /></VBox.margin>
                                <children>
                                    <Button fx:id="btnSalvaDomanda" mnemonicParsing="false" onAction="#handleSaveQuestion" style="-fx-background-color: #1C77FF; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand;" text="Salva domanda">
                                        <font><Font name="System Regular" size="20.0" /></font>
                                        <padding><Insets bottom="10.0" left="30.0" right="30.0" top="10.0" /></padding>
                                    </Button>
                                </children>
                            </HBox>

                        </children>
                    </VBox>
                </children>
            </VBox>
        </content>
    </ScrollPane>

    <!-- ==================== TASTO INDIETRO ==================== -->
    <Button fx:id="btnIndietro" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #1C77FF; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 1.5; -fx-cursor: hand;" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="80.0">
        <graphic>
            <Label style="-fx-text-fill: #000000;" text="←">
                <font>
                    <Font name="System Bold" size="64.0" />
                </font>
            </Label>
        </graphic>
    </Button>

    <!-- ==================== CAMPANELLA NOTIFICHE ==================== -->
    <Button fx:id="btnNotifiche" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #1C77FF; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 1.5; -fx-cursor: hand;" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="40.0">
        <graphic>
            <Label style="-fx-text-fill: #000000;" text="🔔">
                <font><Font size="36.0" /></font>
            </Label>
        </graphic>
    </Button>

</AnchorPane>
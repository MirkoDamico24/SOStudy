<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.dicii.ispw.sostudy.view.CreaTestDetailControllerGUI">

    <!-- ==================== HEADER / NAV BAR ==================== -->
    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="50.0" style="-fx-border-color: #8CB8F5; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 15 60 15 40; -fx-background-color: #FAFAFA; -fx-background-radius: 12;">
                <children>
                    <!-- Logo -->
                    <Label text="SoStudy" textFill="#4D4CFF">
                        <font>
                            <Font name="System Bold Italic" size="36.0" />
                        </font>
                        <HBox.margin>
                            <Insets right="30.0" />
                        </HBox.margin>
                    </Label>

                    <!-- Home (Non più attiva) -->
                    <Button fx:id="btnHome" mnemonicParsing="false" onAction="#handleNavHome" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Home">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>

                    <!-- Crea test (ORA ATTIVA) -->
                    <Button fx:id="btnCreaTest" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #1C77FF transparent; -fx-border-width: 0 0 3 0; -fx-cursor: hand;" text="Crea test">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                        <padding>
                            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                        </padding>
                    </Button>

                    <!-- Classi Virtuali -->
                    <Button fx:id="btnClassiVirtuali" mnemonicParsing="false" onAction="#handleNavClassiVirtuali" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Classi Virtuali">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- ==================== PROFILO UTENTE (Top-Right) ==================== -->
    <HBox alignment="CENTER" spacing="20.0" AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="50.0">
        <children>
            <ImageView fx:id="profAvatar" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="profNameLabel" style="-fx-border-color: #8CB8F5; -fx-border-width: 1; -fx-padding: 8 20 8 20; -fx-background-color: white;" text="Caricamento..." textFill="#555555">
                <font>
                    <Font name="System Regular" size="16.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <!-- ==================== CONTENUTO CENTRALE (Form Crea Test) ==================== -->
    <VBox alignment="TOP_CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="200.0">
        <children>

            <!-- Titolo Pagina -->
            <Label text="Dettagli del test">
                <font>
                    <Font name="Serif Bold" size="48.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="40.0" />
                </VBox.margin>
            </Label>

            <!-- Card del Form -->
            <VBox maxWidth="900.0" style="-fx-background-color: #F5FCFF; -fx-border-color: #1C77FF; -fx-border-width: 1.5; -fx-border-radius: 2; -fx-background-radius: 2;">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
                </padding>
                <children>

                    <!-- Sottotitolo Card -->
                    <Label text="Informazioni del test" textFill="#666666">
                        <font>
                            <Font name="System Regular" size="20.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="5.0" />
                        </VBox.margin>
                    </Label>
                    <Separator prefWidth="200.0">
                        <VBox.margin>
                            <Insets bottom="40.0" />
                        </VBox.margin>
                    </Separator>

                    <!-- Griglia dei Campi -->
                    <GridPane alignment="CENTER" hgap="40.0" vgap="30.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="350.0" minWidth="200.0" prefWidth="250.0" />
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="500.0" minWidth="300.0" prefWidth="400.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>

                            <!-- 1. Nome test -->
                            <Label text="Nome test" textFill="#444444" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <TextField fx:id="nomeTestField" prefHeight="45.0" promptText="Inserire un nome per il test" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <font><Font size="16.0" /></font>
                            </TextField>

                            <!-- 2. Assegna a (ComboBox) -->
                            <Label text="Assegna a" textFill="#444444" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <ComboBox fx:id="classeComboBox" prefHeight="45.0" prefWidth="400.0" promptText="Selezionare una classe virtuale" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <!-- 3. Data di consegna (DatePicker) -->
                            <Label text="Data di consegna" textFill="#444444" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <DatePicker fx:id="dataConsegnaPicker" prefHeight="45.0" prefWidth="400.0" promptText="Selezionare una data di consegna" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <!-- 4. Orario di consegna (ComboBox per le ore) -->
                            <Label text="Orario di consegna" textFill="#444444" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <ComboBox fx:id="orarioComboBox" prefHeight="45.0" prefWidth="400.0" promptText="Selezionare un orario di consegna" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <!-- 5. Durata del test -->
                            <Label text="Durata del test" textFill="#444444" GridPane.columnIndex="0" GridPane.rowIndex="4">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <TextField fx:id="durataField" prefHeight="45.0" promptText="Durata (minuti)" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="4">
                                <font><Font size="16.0" /></font>
                            </TextField>

                        </children>
                    </GridPane>

                    <!-- Bottone Salva -->
                    <HBox alignment="CENTER">
                        <VBox.margin>
                            <Insets top="50.0" />
                        </VBox.margin>
                        <children>
                            <Button fx:id="btnSalva" mnemonicParsing="false" onAction="#handleSaveTest" style="-fx-background-color: #1C77FF; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;" text="Salva">
                                <font>
                                    <Font name="System Bold" size="24.0" />
                                </font>
                                <padding>
                                    <Insets bottom="10.0" left="50.0" right="50.0" top="10.0" />
                                </padding>
                            </Button>
                        </children>
                    </HBox>

                </children>
            </VBox>
        </children>
    </VBox>

    <!-- ==================== CAMPANELLA NOTIFICHE (Top-Left) ==================== -->
    <Button fx:id="btnNotifiche" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #1C77FF; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 1.5; -fx-cursor: hand;" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="40.0">
        <graphic>
            <!-- Simbolo campana come placeholder per icona reale -->
            <Label text="🔔" textFill="BLACK">
                <font>
                    <Font size="36.0" />
                </font>
            </Label>
        </graphic>
    </Button>

</AnchorPane>
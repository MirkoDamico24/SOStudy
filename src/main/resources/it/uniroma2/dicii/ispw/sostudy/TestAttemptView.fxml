<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.dicii.ispw.sostudy.view.gui.TestAttemptViewControllerGUI">

    <!-- ==================== HEADER / NAV BAR ==================== -->
    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="50.0" style="-fx-border-color: #8CB8F5; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 15 60 15 40; -fx-background-color: #FAFAFA; -fx-background-radius: 12;">
                <children>
                    <!-- Logo -->
                    <Label style="-fx-text-fill: #4D4CFF;" text="SoStudy">
                        <font>
                            <Font name="System Bold Italic" size="36.0" />
                        </font>
                        <HBox.margin>
                            <Insets right="30.0" />
                        </HBox.margin>
                    </Label>

                    <!-- Sezione 1: Home -->
                    <Button fx:id="btnHome" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #2D7AF1 transparent; -fx-border-width: 0 0 3 0; -fx-cursor: hand;" text="Home">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                        <padding>
                            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                        </padding>
                    </Button>

                    <!-- Sezione 2: Crea test (Viene nascosto da Java se Utente = Studente) -->
                    <Button fx:id="btnCreaTest" mnemonicParsing="false" onAction="#handleNavCreaTest" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Crea test">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>

                    <!-- Sezione 3: Classi Virtuali -->
                    <Button fx:id="btnClassiVirtuali" mnemonicParsing="false" onAction="#handleNavClassiVirtuali" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Classi Virtuali">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- ==================== PROFILO UTENTE (Dinamico) ==================== -->
    <HBox alignment="CENTER" spacing="20.0" AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="50.0">
        <children>
            <!-- Avatar Dinamico -->
            <ImageView fx:id="userAvatar" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />

            <!-- Nome Dinamico -->
            <Label fx:id="userNameLabel" style="-fx-border-color: #8CB8F5; -fx-border-width: 1; -fx-padding: 8 20 8 20; -fx-background-color: white; -fx-text-fill: #555555;" text="Caricamento...">
                <font>
                    <Font name="System Regular" size="16.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <!-- ==================== CONTENUTO CENTRALE (Dinamico) ==================== -->
    <VBox alignment="TOP_CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="220.0">
        <children>
            <Label style="-fx-text-fill: #000000;" text="Comunicazioni in arrivo">
                <font>
                    <Font name="Serif Bold" size="48.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="60.0" />
                </VBox.margin>
            </Label>

            <!-- Contenitore vuoto pronto per essere riempito da Java -->
            <VBox fx:id="listaAttempt" maxWidth="1000.0" style="-fx-border-color: #555555; -fx-border-width: 2.5; -fx-border-radius: 12; -fx-background-radius: 12; -fx-background-color: #FFFFFF;">
                <padding>
                    <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                </padding>
                <!-- I children verranno aggiunti dal Controller (popolaComunicazioni) -->
            </VBox>
        </children>
    </VBox>

    <!-- ==================== TASTO LOGOUT ==================== -->
    <Button fx:id="btnLogout" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleLogout" prefHeight="90.0" prefWidth="90.0" style="-fx-background-color: #2D7AF1; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 2; -fx-cursor: hand;" AnchorPane.bottomAnchor="80.0" AnchorPane.rightAnchor="80.0">
        <graphic>
            <Label style="-fx-text-fill: #000000;" text="↪">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>
        </graphic>
    </Button>

</AnchorPane>
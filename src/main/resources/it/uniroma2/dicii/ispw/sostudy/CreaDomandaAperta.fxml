<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.uniroma2.dicii.ispw.sostudy.view.CreaDomandaApertaControllerGUI">

    <!-- ==================== HEADER / NAV BAR ==================== -->
    <HBox alignment="CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="50.0" style="-fx-border-color: #8CB8F5; -fx-border-radius: 12; -fx-border-width: 1.5; -fx-padding: 15 60 15 40; -fx-background-color: #FAFAFA; -fx-background-radius: 12;">
                <children>
                    <!-- Logo -->
                    <Label text="SoStudy" textFill="#4D4CFF">
                        <font>
                            <Font name="System Bold Italic" size="36.0" />
                        </font>
                        <HBox.margin>
                            <Insets right="30.0" />
                        </HBox.margin>
                    </Label>

                    <!-- Home -->
                    <Button fx:id="btnHome" mnemonicParsing="false" onAction="#handleNavHome" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Home">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>

                    <!-- Crea test (ATTIVA) -->
                    <Button fx:id="btnCreaTest" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-border-color: transparent transparent #1C77FF transparent; -fx-border-width: 0 0 3 0; -fx-cursor: hand;" text="Crea test">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                        <padding>
                            <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                        </padding>
                    </Button>

                    <!-- Classi Virtuali -->
                    <Button fx:id="btnClassiVirtuali" mnemonicParsing="false" onAction="#handleNavClassiVirtuali" style="-fx-background-color: transparent; -fx-cursor: hand;" text="Classi Virtuali">
                        <font>
                            <Font name="Serif Regular" size="26.0" />
                        </font>
                    </Button>
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- ==================== PROFILO UTENTE (Top-Right) ==================== -->
    <HBox alignment="CENTER" spacing="20.0" AnchorPane.rightAnchor="60.0" AnchorPane.topAnchor="50.0">
        <children>
            <ImageView fx:id="profAvatar" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="profNameLabel" style="-fx-border-color: #8CB8F5; -fx-border-width: 1; -fx-padding: 8 20 8 20; -fx-background-color: white;" text="Caricamento..." textFill="#555555">
                <font>
                    <Font name="System Regular" size="16.0" />
                </font>
            </Label>
        </children>
    </HBox>

    <!-- ==================== CONTENUTO CENTRALE ==================== -->
    <VBox alignment="TOP_CENTER" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="200.0">
        <children>

            <!-- Titolo Pagina -->
            <Label text="Domanda a risposta aperta">
                <font>
                    <Font name="Serif Bold" size="48.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="40.0" />
                </VBox.margin>
            </Label>

            <!-- Card del Form -->
            <VBox maxWidth="1000.0" style="-fx-background-color: #F5FCFF; -fx-border-color: #1C77FF; -fx-border-width: 1.5; -fx-border-radius: 2; -fx-background-radius: 2;">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="20.0" />
                </padding>
                <children>

                    <!-- Sottotitolo Card -->
                    <Label text="Domanda a risposta aperta" textFill="#888888">
                        <font>
                            <Font name="System Regular" size="18.0" />
                        </font>
                        <VBox.margin>
                            <Insets bottom="5.0" />
                        </VBox.margin>
                    </Label>
                    <Separator prefWidth="200.0">
                        <VBox.margin>
                            <Insets bottom="40.0" />
                        </VBox.margin>
                    </Separator>

                    <!-- Griglia dei Campi -->
                    <GridPane alignment="CENTER" hgap="40.0" vgap="40.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="350.0" minWidth="200.0" prefWidth="300.0" />
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="600.0" minWidth="300.0" prefWidth="500.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="80.0" prefHeight="100.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>

                            <!-- 1. Testo della domanda (TextArea) -->
                            <Label text="Testo della domanda" textFill="#555555" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.valignment="TOP">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                                <GridPane.margin>
                                    <Insets top="10.0" />
                                </GridPane.margin>
                            </Label>
                            <TextArea fx:id="testoDomandaArea" prefHeight="100.0" prefWidth="500.0" promptText="Inserire il testo della domanda" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <font><Font size="16.0" /></font>
                            </TextArea>

                            <!-- 2. Punteggio (ComboBox) -->
                            <Label text="Punteggio" textFill="#555555" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <font><Font name="Serif Regular" size="30.0" /></font>
                            </Label>
                            <ComboBox fx:id="punteggioComboBox" prefHeight="45.0" prefWidth="500.0" promptText="Selezionare il punteggio massimo" style="-fx-background-color: white; -fx-border-color: #8CB8F5; -fx-border-radius: 3;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        </children>
                    </GridPane>

                    <!-- Bottone Salva Domanda -->
                    <HBox alignment="CENTER">
                        <VBox.margin>
                            <Insets top="60.0" />
                        </VBox.margin>
                        <children>
                            <Button fx:id="btnSalvaDomanda" mnemonicParsing="false" onAction="#handleSalvaDomanda" style="-fx-background-color: #1C77FF; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand;" text="Salva domanda">
                                <font>
                                    <Font name="System Regular" size="20.0" />
                                </font>
                                <padding>
                                    <Insets bottom="10.0" left="30.0" right="30.0" top="10.0" />
                                </padding>
                            </Button>
                        </children>
                    </HBox>

                </children>
            </VBox>
        </children>
    </VBox>

    <!-- ==================== TASTO INDIETRO (Bottom-Left) ==================== -->
    <Button fx:id="btnIndietro" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleIndietro" prefHeight="100.0" prefWidth="100.0" style="-fx-background-color: #1C77FF; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 1.5; -fx-cursor: hand;" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="80.0">
        <graphic>
            <!-- Freccia Indietro (Unicode) -->
            <Label text="←" textFill="BLACK">
                <font>
                    <Font name="System Bold" size="64.0" />
                </font>
            </Label>
        </graphic>
    </Button>

    <!-- ==================== CAMPANELLA NOTIFICHE (Top-Left) ==================== -->
    <Button fx:id="btnNotifiche" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="80.0" prefWidth="80.0" style="-fx-background-color: #1C77FF; -fx-background-radius: 50em; -fx-border-color: #000000; -fx-border-radius: 50em; -fx-border-width: 1.5; -fx-cursor: hand;" AnchorPane.leftAnchor="60.0" AnchorPane.topAnchor="40.0">
        <graphic>
            <Label text="🔔" textFill="BLACK">
                <font>
                    <Font size="36.0" />
                </font>
            </Label>
        </graphic>
    </Button>

</AnchorPane>